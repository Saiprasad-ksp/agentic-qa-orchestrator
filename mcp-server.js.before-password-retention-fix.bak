const fs = require('fs');

console.error(
  '[MCP config] ' +
  JSON.stringify({
    runTarget: process.env.RUN_TARGET || 'local',
    targetEnv: process.env.TARGET_ENV || 'not-set',
    oliveOpenTimeoutMs:
      process.env.OLIVE_OPEN_TIMEOUT_MS || '60000-default',
    oliveSurfaceTimeoutMs:
      process.env.OLIVE_SURFACE_TIMEOUT_MS || '6000-default',
    oliveGreetingTimeoutMs:
      process.env.OLIVE_INITIAL_GREETING_TIMEOUT_MS ||
      '30000-default',
    browserStackCredentialsAvailable:
      Boolean(
        process.env.BROWSERSTACK_USERNAME &&
        process.env.BROWSERSTACK_ACCESS_KEY
      ),
  })
);
const path = require('path');
const { Server } = require('@modelcontextprotocol/sdk/server/index.js');
const { StdioServerTransport } = require('@modelcontextprotocol/sdk/server/stdio.js');
const { CallToolRequestSchema, ListToolsRequestSchema } = require('@modelcontextprotocol/sdk/types.js');
const { chromium } = require('playwright');
const { PNG } = require('pngjs');
const { OliveWebBot } = require('./src/oliveWebBot');
const { loadProjectEnv, readEnv } = require('./src/env');
const { runAdvancedHelpCenterExploration } = require('./src/helpCenterAdvancedExplorer');

loadProjectEnv('.env.web', '.env.llm', '.env.browserstack');

let browser = null;
let browserContext = null;
let page = null;
let olive = null;

const rootDir = __dirname;
const reportsDir = path.resolve(rootDir, 'reports');
const screenshotsDir = path.resolve(reportsDir, 'screenshots');
const baselineDir = path.resolve(rootDir, 'visual-baselines');
const actualDir = path.resolve(rootDir, 'visual-actuals');
const diffDir = path.resolve(rootDir, 'visual-diffs');
const auditDir = path.resolve(reportsDir, 'audits');

const server = new Server(
  { name: 'qa-automation-web-mcp', version: '3.0.0' },
  { capabilities: { tools: {} } },
);

function ensureDirs() {
  for (const dir of [reportsDir, screenshotsDir, baselineDir, actualDir, diffDir, auditDir]) {
    fs.mkdirSync(dir, { recursive: true });
  }
}

function safeBaseName(name) {
  const raw = String(name || `screenshot-${Date.now()}`);
  const withoutExt = raw.replace(/\.png$/i, '');
  return path.basename(withoutExt).replace(/[^a-z0-9-_]/gi, '_').toLowerCase();
}

function screenshotPath(name, dir = screenshotsDir) {
  return path.join(dir, `${safeBaseName(name)}.png`);
}

function jsonPath(name, dir = auditDir) {
  const raw = String(name || `audit-${Date.now()}`).replace(/\.json$/i, '');
  const safe = path.basename(raw).replace(/[^a-z0-9-_]/gi, '_').toLowerCase();
  return path.join(dir, `${safe}.json`);
}

async function createBrowser() {
  const runTarget = readEnv('RUN_TARGET', 'local').toLowerCase();

  if (runTarget === 'browserstack') {
    const username = readEnv('BROWSERSTACK_USERNAME');
    const accessKey = readEnv('BROWSERSTACK_ACCESS_KEY');

    if (!username || !accessKey) {
      throw new Error('RUN_TARGET=browserstack requires BROWSERSTACK_USERNAME and BROWSERSTACK_ACCESS_KEY in .env.browserstack.');
    }

    const caps = {
      browser: readEnv('WEB_BROWSER', 'chrome'),
      browser_version: readEnv('WEB_BROWSER_VERSION', 'latest'),
      os: readEnv('WEB_OS', 'Windows'),
      os_version: readEnv('WEB_OS_VERSION', '11'),
      name: readEnv('BROWSERSTACK_SESSION', 'Woolworths Web MCP Session'),
      build: readEnv('BROWSERSTACK_BUILD', 'Woolworths Web MCP Build'),
      project: readEnv('BROWSERSTACK_PROJECT', 'Woolworths QA Automation'),
      'browserstack.username': username,
      'browserstack.accessKey': accessKey,
      'browserstack.debug': 'true',
      'browserstack.console': 'info',
      'browserstack.networkLogs': 'true',
    };

    const wsEndpoint = `wss://cdp.browserstack.com/playwright?caps=${encodeURIComponent(JSON.stringify(caps))}`;
    return chromium.connect(wsEndpoint);
  }

  return chromium.launch({
    channel: process.env.PLAYWRIGHT_CHANNEL || undefined,
    headless: process.env.HEADLESS !== 'false',
    slowMo: Number(process.env.PLAYWRIGHT_SLOW_MO_MS || 0),
  });
}


function loadDeterministicCredentials() {
  const credentialsPath = path.resolve(
    rootDir,
    process.env.AGENTIC_QA_CREDENTIALS_DIR || '.credentials',
    'login.env'
  );

  if (!fs.existsSync(credentialsPath)) {
    throw new Error(
      `Deterministic login credentials were not found: ${credentialsPath}`
    );
  }

  const allowedKeys = new Set([
    'LOGIN_URL_UAT',
    'LOGIN_URL_PROD',
    'TEST_LOGIN_EMAIL',
    'TEST_LOGIN_PASSWORD',
  ]);

  const lines = fs
    .readFileSync(credentialsPath, 'utf8')
    .replace(/\r/g, '')
    .split('\n');

  for (const originalLine of lines) {
    let line = originalLine.trim();

    if (!line || line.startsWith('#')) {
      continue;
    }

    line = line.replace(/^export\s+/, '');

    const equalsIndex = line.indexOf('=');

    if (equalsIndex <= 0) {
      continue;
    }

    const key = line.slice(0, equalsIndex).trim();

    if (!allowedKeys.has(key)) {
      continue;
    }

    let value = line.slice(equalsIndex + 1).trim();

    if (
      value.length >= 2 &&
      (
        (value.startsWith('"') && value.endsWith('"')) ||
        (value.startsWith("'") && value.endsWith("'"))
      )
    ) {
      value = value.slice(1, -1);
    }

    process.env[key] = value;
  }

  const targetEnv = String(
    process.env.TARGET_ENV || 'UAT'
  ).toUpperCase();

  const loginUrl =
    targetEnv === 'PROD'
      ? process.env.LOGIN_URL_PROD
      : process.env.LOGIN_URL_UAT;

  const email = process.env.TEST_LOGIN_EMAIL;
  const password = process.env.TEST_LOGIN_PASSWORD;

  if (!loginUrl || !email || !password) {
    throw new Error(
      `Deterministic login configuration is incomplete for ${targetEnv}.`
    );
  }

  return {
    loginUrl,
    email,
    password,
  };
}

async function findVisibleLoginButton(
  activePage,
  timeout = 30000
) {
  const deadline = Date.now() + timeout;

  const selector = [
    'button[data-action-button-primary="true"]:not([aria-hidden="true"]):not(.ulp-hidden-form-submit-button)',
    'button[type="submit"]:not([aria-hidden="true"]):not(.ulp-hidden-form-submit-button)',
  ].join(', ');

  while (Date.now() < deadline) {
    const candidates =
      activePage.locator(selector);

    const count =
      await candidates.count();

    for (
      let index = 0;
      index < count;
      index += 1
    ) {
      const candidate =
        candidates.nth(index);

      try {
        const label = String(
          await candidate.innerText()
        )
          .replace(/\s+/g, ' ')
          .trim();

        if (
          /^log in$/i.test(label) &&
          await candidate.isVisible() &&
          await candidate.isEnabled()
        ) {
          return candidate;
        }
      } catch (_) {
        // Ignore stale or temporarily unavailable buttons.
      }
    }

    await activePage.waitForTimeout(250);
  }

  return null;
}

async function performDeterministicLogin(
  activePage
) {
  const {
    loginUrl,
    email,
    password,
  } = loadDeterministicCredentials();

  console.error(
    `[MCP auth] Starting deterministic login in execution browser: ${loginUrl}`
  );

  await activePage.goto(
    loginUrl,
    {
      waitUntil: 'domcontentloaded',
      timeout: 120000,
    }
  );

  const emailInput =
    activePage
      .locator([
        '#username',
        'input[type="email"]',
        'input[name="email"]',
        'input[autocomplete="username"]',
        '[data-testid="email"]',
      ].join(', '))
      .first();

  await emailInput.waitFor({
    state: 'visible',
    timeout: 60000,
  });

  await emailInput.fill(email);

  const firstLoginButton =
    await findVisibleLoginButton(activePage);

  if (!firstLoginButton) {
    throw new Error(
      'First deterministic Log in button was not found.'
    );
  }

  await firstLoginButton.click();

  const passwordInput =
    activePage
      .locator([
        '#password',
        'input[type="password"]',
        'input[name="password"]',
        'input[autocomplete="current-password"]',
        '[data-testid="password"]',
      ].join(', '))
      .first();

  await passwordInput.waitFor({
    state: 'visible',
    timeout: 60000,
  });

  await passwordInput.fill(password);

  const secondLoginButton =
    await findVisibleLoginButton(activePage);

  if (!secondLoginButton) {
    throw new Error(
      'Second deterministic Log in button was not found.'
    );
  }

  await secondLoginButton.click();

  await activePage
    .waitForURL(
      url =>
        !/\/u\/login|\/authorize|auth0/i.test(
          String(url)
        ),
      {
        timeout: 120000,
      }
    )
    .catch(() => {});

  const targetEnv = String(
    process.env.TARGET_ENV || 'UAT'
  ).toUpperCase();

  const appUrl =
    targetEnv === 'PROD'
      ? process.env.URL_PROD ||
        'https://www.woolworths.com.au'
      : process.env.URL_UAT ||
        'https://uatsite.woolworths.com.au';

  await activePage.goto(
    appUrl,
    {
      waitUntil: 'domcontentloaded',
      timeout: 120000,
    }
  );

  await activePage.waitForTimeout(2500);

  if (
    /\/u\/login|\/authorize|auth0/i.test(
      activePage.url()
    )
  ) {
    throw new Error(
      `Deterministic authentication did not reach the application. Current URL: ${activePage.url()}`
    );
  }

  console.error(
    `[MCP auth] Authenticated execution browser ready: ${activePage.url()}`
  );
}

async function ensurePage() {
  ensureDirs();

  if (!browser) {
    browser = await createBrowser();

    const contextOptions = {
      viewport: {
        width: 1440,
        height: 1100,
      },
    };

    const configuredStorageState =
      String(
        process.env.PLAYWRIGHT_STORAGE_STATE || ''
      ).trim();

    if (configuredStorageState) {
      const storageStatePath = path.resolve(
        rootDir,
        configuredStorageState
      );

      if (!fs.existsSync(storageStatePath)) {
        throw new Error(
          `PLAYWRIGHT_STORAGE_STATE does not exist: ${storageStatePath}`
        );
      }

      const storageStateStats =
        fs.statSync(storageStatePath);

      if (storageStateStats.size === 0) {
        throw new Error(
          `PLAYWRIGHT_STORAGE_STATE is empty: ${storageStatePath}`
        );
      }

      contextOptions.storageState =
        storageStatePath;

      console.error(
        `[MCP auth] Loading authenticated storage state: ${storageStatePath}`
      );
    } else {
      console.error(
        '[MCP auth] No authenticated storage state configured.'
      );
    }

    browserContext =
      await browser.newContext(contextOptions);

    page =
      await browserContext.newPage();

    if (
      String(
        process.env.MCP_DETERMINISTIC_AUTH || ''
      ).toLowerCase() === 'true'
    ) {
      await performDeterministicLogin(page);
    }

    olive =
      new OliveWebBot(page);
  }

  return page;
}

async function waitForStablePage(activePage) {
  await activePage.waitForLoadState('domcontentloaded', { timeout: 60000 }).catch(() => {});
  await activePage.waitForLoadState('networkidle', { timeout: 30000 }).catch(() => {});
  await activePage.waitForTimeout(Number(readEnv('PAGE_SETTLE_MS', '1500')));
}

async function takeFullPageScreenshot(activePage, name, dir = screenshotsDir) {
  ensureDirs();
  const filePath = screenshotPath(name, dir);
  await activePage.screenshot({ path: filePath, fullPage: true });
  return filePath;
}

async function compareImages({ baselinePath, actualPath, diffPath, threshold = 0.12 }) {
  const pixelmatch = (await import('pixelmatch')).default;

  const baseline = PNG.sync.read(fs.readFileSync(baselinePath));
  const actual = PNG.sync.read(fs.readFileSync(actualPath));

  const compareWidth = Math.min(baseline.width, actual.width);
  const compareHeight = Math.min(baseline.height, actual.height);

  const dimensionMismatch =
    baseline.width !== actual.width ||
    baseline.height !== actual.height;

  const crop = (source) => {
    const cropped = new PNG({ width: compareWidth, height: compareHeight });

    for (let y = 0; y < compareHeight; y += 1) {
      for (let x = 0; x < compareWidth; x += 1) {
        const sourceIdx = (source.width * y + x) << 2;
        const targetIdx = (compareWidth * y + x) << 2;

        cropped.data[targetIdx] = source.data[sourceIdx];
        cropped.data[targetIdx + 1] = source.data[sourceIdx + 1];
        cropped.data[targetIdx + 2] = source.data[sourceIdx + 2];
        cropped.data[targetIdx + 3] = source.data[sourceIdx + 3];
      }
    }

    return cropped;
  };

  const baselineComparable = crop(baseline);
  const actualComparable = crop(actual);

  const diff = new PNG({ width: compareWidth, height: compareHeight });

  const mismatchPixels = pixelmatch(
    baselineComparable.data,
    actualComparable.data,
    diff.data,
    compareWidth,
    compareHeight,
    {
      threshold,
      includeAA: true,
      diffColor: [255, 0, 0],
      diffColorAlt: [0, 0, 255],
      aaColor: [255, 165, 0],
      alpha: 0.15,
    },
  );

  const totalPixels = compareWidth * compareHeight;
  const mismatchRatio = mismatchPixels / totalPixels;
  const maxMismatchRatio = Number(readEnv('VISUAL_MAX_MISMATCH_RATIO', '0.01'));

  const hasDifference = mismatchPixels > 0 || dimensionMismatch;
  let finalDiffPath = null;
  let overlayPath = null;

  if (hasDifference) {
    fs.writeFileSync(diffPath, PNG.sync.write(diff));
    finalDiffPath = diffPath;

    const overlay = new PNG({ width: compareWidth, height: compareHeight });

    for (let y = 0; y < compareHeight; y += 1) {
      for (let x = 0; x < compareWidth; x += 1) {
        const idx = (compareWidth * y + x) << 2;

        const br = baselineComparable.data[idx];
        const bg = baselineComparable.data[idx + 1];
        const bb = baselineComparable.data[idx + 2];
        const ba = baselineComparable.data[idx + 3];

        const ar = actualComparable.data[idx];
        const ag = actualComparable.data[idx + 1];
        const ab = actualComparable.data[idx + 2];
        const aa = actualComparable.data[idx + 3];

        const delta =
          Math.abs(br - ar) +
          Math.abs(bg - ag) +
          Math.abs(bb - ab) +
          Math.abs(ba - aa);

        overlay.data[idx] = ar;
        overlay.data[idx + 1] = ag;
        overlay.data[idx + 2] = ab;
        overlay.data[idx + 3] = aa;

        if (delta > Number(readEnv('VISUAL_RAW_PIXEL_DELTA', '60'))) {
          overlay.data[idx] = 255;
          overlay.data[idx + 1] = 0;
          overlay.data[idx + 2] = 0;
          overlay.data[idx + 3] = 255;
        }
      }
    }

    if (dimensionMismatch) {
      const border = 8;

      for (let y = 0; y < compareHeight; y += 1) {
        for (let x = 0; x < compareWidth; x += 1) {
          const isBorder =
            x < border ||
            y < border ||
            x >= compareWidth - border ||
            y >= compareHeight - border;

          if (isBorder) {
            const idx = (compareWidth * y + x) << 2;
            overlay.data[idx] = 255;
            overlay.data[idx + 1] = 0;
            overlay.data[idx + 2] = 0;
            overlay.data[idx + 3] = 255;
          }
        }
      }
    }

    overlayPath = diffPath.replace(/\.png$/i, '_overlay.png');
    fs.writeFileSync(overlayPath, PNG.sync.write(overlay));
  }

  /*
   * Visual pixel differences are informational evidence.
   * A successful image comparison must not fail the functional scenario.
   *
   * Processing errors such as unreadable images, missing actual files or
   * pixelmatch exceptions still throw before reaching this point.
   */
  const differenceDetected =
    mismatchPixels > 0 ||
    dimensionMismatch;

  const withinConfiguredTolerance =
    mismatchRatio <=
    maxMismatchRatio;

  const passed = true;
  const scenarioFailure = false;
  const severity =
    differenceDetected
      ? 'informational'
      : 'none';

  return {
    compared: true,
    passed,
    hasDifference,
    reason: passed
      ? hasDifference
        ? dimensionMismatch
          ? `Visual comparison passed on common area ${compareWidth}x${compareHeight}. Warning: baseline size ${baseline.width}x${baseline.height}, actual size ${actual.width}x${actual.height}.`
          : `Visual comparison passed with minor difference ratio ${mismatchRatio.toFixed(5)}.`
        : 'Visual comparison passed. No pixel differences detected.'
      : `Visual differences detected: mismatch ratio ${mismatchRatio.toFixed(5)} exceeded configured reference tolerance ${maxMismatchRatio}. Difference recorded as informational; scenario was not failed.`,
    dimensionMismatch,
    baselineSize: `${baseline.width}x${baseline.height}`,
    actualSize: `${actual.width}x${actual.height}`,
    comparedSize: `${compareWidth}x${compareHeight}`,
    mismatchPixels,
    totalPixels,
    mismatchRatio,
    maxMismatchRatio,
    differenceDetected,
    withinConfiguredTolerance,
    scenarioFailure,
    severity,
    threshold,
    diffPath: finalDiffPath,
    overlayPath,
  };
}

async function auditLinksAndButtons(activePage, options = {}) {
  const maxLinksToCheck = Number(options.maxLinksToCheck || readEnv('AUDIT_MAX_LINKS_TO_CHECK', '40'));

  const raw = await activePage.evaluate(() => {
    const isVisible = el => {
      const style = window.getComputedStyle(el);
      const rect = el.getBoundingClientRect();
      return style &&
        style.visibility !== 'hidden' &&
        style.display !== 'none' &&
        rect.width > 0 &&
        rect.height > 0;
    };

    const textOf = el => [
      el.innerText,
      el.textContent,
      el.getAttribute('aria-label'),
      el.getAttribute('title'),
      el.getAttribute('placeholder'),
      el.value,
    ].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();

    const links = Array.from(document.querySelectorAll('a'))
      .filter(isVisible)
      .map((el, index) => ({
        index,
        text: textOf(el).slice(0, 180),
        href: el.href || el.getAttribute('href') || '',
        target: el.getAttribute('target') || '',
        area: el.closest('header') ? 'header' : el.closest('footer') ? 'footer' : 'main',
        disabled: Boolean(el.disabled || el.getAttribute('aria-disabled') === 'true'),
      }));

    const buttons = Array.from(document.querySelectorAll('button, [role="button"]'))
      .filter(isVisible)
      .map((el, index) => ({
        index,
        text: textOf(el).slice(0, 180),
        role: el.getAttribute('role') || el.tagName.toLowerCase(),
        type: el.getAttribute('type') || '',
        area: el.closest('header') ? 'header' : el.closest('footer') ? 'footer' : 'main',
        disabled: Boolean(el.disabled || el.getAttribute('aria-disabled') === 'true'),
        expanded: el.getAttribute('aria-expanded'),
      }));

    return {
      url: location.href,
      origin: location.origin,
      title: document.title,
      links,
      buttons,
    };
  });

  const importantPattern = /help|faq|contact|order|delivery|pickup|refund|return|account|rewards|manage/i;
  const checkedLinks = [];
  const warnings = [];
  const errors = [];

  for (const link of raw.links.slice(0, maxLinksToCheck)) {
    const result = { ...link, status: 'not_checked', ok: true, severity: 'none', issue: '' };

    if (!link.href) {
      result.status = 'missing_href';
      result.ok = false;
      result.severity = importantPattern.test(link.text) ? 'error' : 'warning';
      result.issue = 'Visible link has no href.';
      checkedLinks.push(result);
      (result.severity === 'error' ? errors : warnings).push(result);
      continue;
    }

    if (
      link.href.startsWith('mailto:') ||
      link.href.startsWith('tel:') ||
      link.href.startsWith('javascript:') ||
      link.href.includes('#')
    ) {
      result.status = 'skipped_protocol_or_anchor';
      checkedLinks.push(result);
      continue;
    }

    let url;
    try {
      url = new URL(link.href);
    } catch (_) {
      result.status = 'invalid_url';
      result.ok = false;
      result.severity = importantPattern.test(link.text) ? 'error' : 'warning';
      result.issue = 'Invalid URL.';
      checkedLinks.push(result);
      (result.severity === 'error' ? errors : warnings).push(result);
      continue;
    }

    const sameOrigin = url.origin === raw.origin;
    if (!sameOrigin) {
      result.status = 'skipped_external';
      checkedLinks.push(result);
      continue;
    }

    try {
      const response = await activePage.request.get(link.href, {
        timeout: Number(readEnv('LINK_CHECK_TIMEOUT_MS', '12000')),
        maxRedirects: 3,
      });

      result.status = response.status();

      if ([404, 410].includes(response.status()) || response.status() >= 500) {
        result.ok = false;
        result.severity = 'error';
        result.issue = `Important internal link returned HTTP ${response.status()}`;
        errors.push(result);
      } else if (response.status() >= 400) {
        result.ok = false;
        result.severity = 'warning';
        result.issue = `Internal link returned HTTP ${response.status()}. This may be expected on UAT/protected pages.`;
        warnings.push(result);
      }
    } catch (error) {
      result.status = 'request_failed';
      result.ok = false;
      result.severity = importantPattern.test(link.text) ? 'error' : 'warning';
      result.issue = error.message;
      (result.severity === 'error' ? errors : warnings).push(result);
    }

    checkedLinks.push(result);
  }

  const disabledButtons = raw.buttons
    .filter(button => button.disabled)
    .map(button => ({
      ...button,
      ok: false,
      severity: importantPattern.test(button.text) ? 'error' : 'warning',
      issue: 'Visible button is disabled.',
    }));

  for (const button of disabledButtons) {
    (button.severity === 'error' ? errors : warnings).push(button);
  }

  return {
    url: raw.url,
    title: raw.title,
    summary: {
      visibleLinks: raw.links.length,
      visibleButtons: raw.buttons.length,
      checkedLinks: checkedLinks.length,
      errors: errors.length,
      warnings: warnings.length,
      linkIssues: checkedLinks.filter(link => !link.ok).length,
      disabledVisibleButtons: disabledButtons.length,
      passed: errors.length === 0,
    },
    links: raw.links,
    checkedLinks,
    buttons: raw.buttons,
    warnings,
    errors,
  };
}

async function exploreHelpCenter(activePage, options = {}) {
  const maxInteractions = Number(options.maxInteractions || readEnv('EXPLORE_MAX_INTERACTIONS', '12'));
  const screenshotPrefix = options.screenshotPrefix || options.name || 'helpcenter_explore';

  const selector = [
    'main a',
    'main button',
    'main [role="button"]',
    'main [aria-expanded]',
    'a[href*="help"]',
    'a[href*="faq"]',
    'a[href*="contact"]',
    'a[href*="order"]',
    'button[aria-expanded]',
  ].join(', ');

  const exploration = {
    startedAt: new Date().toISOString(),
    url: activePage.url(),
    screenshots: [],
    interactions: [],
    scrollSnapshots: [],
    errors: [],
    summary: {
      candidateCount: 0,
      interactionCount: 0,
      screenshotCount: 0,
      passed: false,
    },
  };

  const initialPath = await takeFullPageScreenshot(activePage, `${screenshotPrefix}_initial`);
  exploration.screenshots.push(initialPath);

  const collectCandidates = async () => activePage.locator(selector).evaluateAll(elements => {
    const isVisible = el => {
      const style = window.getComputedStyle(el);
      const rect = el.getBoundingClientRect();
      return style &&
        style.visibility !== 'hidden' &&
        style.display !== 'none' &&
        rect.width > 0 &&
        rect.height > 0;
    };

    const textOf = el => [
      el.innerText,
      el.textContent,
      el.getAttribute('aria-label'),
      el.getAttribute('title'),
    ].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();

    const exclude = /skip to|log in|sign up|cart|search|shop now|boost now|t&c|catalogue|recipes|stores|specials|browse products|delivery to|select a time/i;
    const prefer = /help|faq|contact|order|delivery|pickup|refund|return|account|rewards|manage|missing|change|online|payment|issue|support/i;

    return elements
      .map((el, index) => {
        const text = textOf(el);
        return {
          index,
          tag: el.tagName.toLowerCase(),
          text: text.slice(0, 180),
          href: el.href || el.getAttribute('href') || '',
          expanded: el.getAttribute('aria-expanded'),
          disabled: Boolean(el.disabled || el.getAttribute('aria-disabled') === 'true'),
          visible: isVisible(el),
          score: prefer.test(text + ' ' + (el.href || '')) ? 2 : 1,
        };
      })
      .filter(item => item.visible && !item.disabled)
      .filter(item => item.text || item.href)
      .filter(item => !exclude.test(item.text))
      .sort((a, b) => b.score - a.score)
      .slice(0, 50);
  }).catch(() => []);

  let candidates = await collectCandidates();
  exploration.summary.candidateCount = candidates.length;

  const usedKeys = new Set();

  for (const candidate of candidates) {
    if (exploration.interactions.length >= maxInteractions) break;

    const key = `${candidate.text}|${candidate.href}`.toLowerCase();
    if (usedKeys.has(key)) continue;
    usedKeys.add(key);

    const beforeUrl = activePage.url();

    try {
      const locator = activePage.locator(selector).nth(candidate.index);

      if (!(await locator.isVisible({ timeout: 3000 }).catch(() => false))) {
        continue;
      }

      await locator.scrollIntoViewIfNeeded().catch(() => {});
      await activePage.waitForTimeout(400);

      await locator.click({ timeout: 8000 }).catch(async () => {
        await locator.click({ timeout: 8000, force: true });
      });

      await waitForStablePage(activePage);

      const afterUrl = activePage.url();
      const safeName = `${screenshotPrefix}_${exploration.interactions.length + 1}_${safeBaseName(candidate.text || candidate.tag).slice(0, 45)}`;
      const shot = await takeFullPageScreenshot(activePage, safeName);

      exploration.screenshots.push(shot);
      exploration.interactions.push({
        text: candidate.text,
        tag: candidate.tag,
        href: candidate.href,
        beforeUrl,
        afterUrl,
        screenshot: shot,
      });

      if (afterUrl !== beforeUrl) {
        await activePage.goBack({ waitUntil: 'domcontentloaded', timeout: 30000 }).catch(() => {});
        await waitForStablePage(activePage);
      }
    } catch (error) {
      exploration.errors.push({
        candidate,
        error: error.message,
      });
    }
  }

  if (exploration.interactions.length === 0) {
    for (let i = 1; i <= 4; i += 1) {
      await activePage.mouse.wheel(0, 900).catch(() => {});
      await activePage.waitForTimeout(700);
      const shot = await takeFullPageScreenshot(activePage, `${screenshotPrefix}_scroll_${i}`);
      exploration.screenshots.push(shot);
      exploration.scrollSnapshots.push({
        action: `scroll_${i}`,
        screenshot: shot,
      });
    }
  }

  exploration.endedAt = new Date().toISOString();
  exploration.summary.interactionCount = exploration.interactions.length;
  exploration.summary.screenshotCount = exploration.screenshots.length;
  exploration.summary.passed = exploration.interactions.length > 0 || exploration.scrollSnapshots.length > 0;

  return exploration;
}

server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name: 'pw_navigate',
      description: 'Navigate to a URL using Playwright and initialise the page session.',
      inputSchema: {
        type: 'object',
        properties: { url: { type: 'string' } },
        required: ['url'],
      },
    },
    {
      name: 'pw_take_screenshot',
      description: 'Capture a full-page screenshot. The server normalises the filename so .png is not duplicated.',
      inputSchema: {
        type: 'object',
        properties: { filename: { type: 'string' } },
        required: ['filename'],
      },
    },
    {
      name: 'pw_visual_snapshot',
      description: 'Capture a visual snapshot into visual-actuals and create a baseline if it does not exist.',
      inputSchema: {
        type: 'object',
        properties: {
          name: { type: 'string' },
          updateBaseline: { type: 'boolean' },
        },
        required: ['name'],
      },
    },
    {
      name: 'pw_compare_visual',
      description: 'Compare an actual screenshot against a baseline and create a diff image.',
      inputSchema: {
        type: 'object',
        properties: {
          name: { type: 'string' },
          threshold: { type: 'number' },
        },
        required: ['name'],
      },
    },
    {
      name: 'pw_audit_links_buttons',
      description: 'Audit visible links and buttons on the current page. Checks hrefs, HTTP status for links, and disabled visible buttons.',
      inputSchema: {
        type: 'object',
        properties: {
          name: { type: 'string' },
          maxLinksToCheck: { type: 'number' },
        },
      },
    },
    {
      name: 'pw_explore_helpcenter',
      description: 'Exploratory testing for the Help Centre page. Clicks safe FAQ/help controls, captures screenshots after interactions, and writes audit JSON.',
      inputSchema: {
        type: 'object',
        properties: {
          name: { type: 'string' },
          maxInteractions: { type: 'number' },
        },
      },
    },
    {
      name: 'pw_open_olive',
      description: 'Open the Woolworths Olive / Ask Anything chat surface and wait until a chat textbox is available.',
      inputSchema: { type: 'object', properties: {} },
    },
    {
      name: 'pw_send_olive_message',
      description: 'Send a realistic customer message to Olive and return the newly captured bot response text.',
      inputSchema: {
        type: 'object',
        properties: { text: { type: 'string' } },
        required: ['text'],
      },
    },
    {
      name: 'pw_read_olive_conversation',
      description: 'Read the visible Olive conversation text from the page and any chat iframe/webview frame.',
      inputSchema: { type: 'object', properties: {} },
    },
    {
      name: 'pw_click_button',
      description: 'Click a button or element using accessible name/text. Use only for stable navigation actions.',
      inputSchema: {
        type: 'object',
        properties: { targetText: { type: 'string' } },
        required: ['targetText'],
      },
    },
    {
      name: 'pw_type_and_enter',
      description: 'Type into the first visible text input or textarea and press Enter.',
      inputSchema: {
        type: 'object',
        properties: { text: { type: 'string' } },
        required: ['text'],
      },
    },
    {
      name: 'pw_verify_text_present',
      description: 'Check if specific visible text exists. Do not use for generative bot answers; use the LLM judge instead.',
      inputSchema: {
        type: 'object',
        properties: { expectedText: { type: 'string' } },
        required: ['expectedText'],
      },
    },
  ],
}));

server.setRequestHandler(CallToolRequestSchema, async request => {
  const { name, arguments: args = {} } = request.params;

  try {
    ensureDirs();
    const activePage = await ensurePage();

    switch (name) {
      case 'pw_navigate': {
        await activePage.goto(args.url, { waitUntil: 'domcontentloaded', timeout: 60000 });
        await waitForStablePage(activePage);
        return {
          content: [{ type: 'text', text: `Navigated to ${args.url}` }],
        };
      }

      case 'pw_take_screenshot': {
        const filePath = await takeFullPageScreenshot(activePage, args.filename);
        return {
          content: [{ type: 'text', text: `Screenshot saved to ${filePath}` }],
        };
      }

      case 'pw_visual_snapshot': {
        const envPrefix = readEnv('TARGET_ENV', 'PROD').toLowerCase();
        const nameBase = `${envPrefix}_${safeBaseName(args.name)}`;
        const actualPath = screenshotPath(nameBase, actualDir);
        const baselinePath = screenshotPath(nameBase, baselineDir);

        await activePage.screenshot({ path: actualPath, fullPage: true });

        let baselineAction = 'baseline_exists';

        if (args.updateBaseline === true || !fs.existsSync(baselinePath)) {
          fs.copyFileSync(actualPath, baselinePath);
          baselineAction = args.updateBaseline === true ? 'baseline_updated' : 'baseline_created';
        }

        const result = {
          name: nameBase,
          actualPath,
          baselinePath,
          baselineAction,
        };

        return {
          content: [{
            type: 'text',
            text:
              `Visual snapshot captured.\n` +
              `Actual: ${actualPath}\n` +
              `Baseline: ${baselinePath}\n` +
              `Baseline action: ${baselineAction}\n` +
              JSON.stringify(result, null, 2),
          }],
        };
      }

      case 'pw_compare_visual': {
        const envPrefix = readEnv('TARGET_ENV', 'PROD').toLowerCase();
        const nameBase = `${envPrefix}_${safeBaseName(args.name)}`;
        const actualPath = screenshotPath(nameBase, actualDir);
        const baselinePath = screenshotPath(nameBase, baselineDir);
        const diffPath = screenshotPath(nameBase, diffDir);

        if (!fs.existsSync(actualPath)) {
          await activePage.screenshot({ path: actualPath, fullPage: true });
        }

        if (!fs.existsSync(baselinePath)) {
          fs.copyFileSync(actualPath, baselinePath);

          const created = {
            name: nameBase,
            passed: true,
            compared: false,
            reason: 'Baseline did not exist. Created baseline from current page. Re-run to perform comparison.',
            actualPath,
            baselinePath,
            diffPath: null,
          };

          return {
            content: [{
              type: 'text',
              text:
                `Baseline created. Re-run required for comparison.\n` +
                `Actual: ${actualPath}\n` +
                `Baseline: ${baselinePath}\n` +
                JSON.stringify(created, null, 2),
            }],
          };
        }

        const comparison = await compareImages({
          baselinePath,
          actualPath,
          diffPath,
          threshold: Number(args.threshold || readEnv('VISUAL_PIXEL_THRESHOLD', '0.12')),
        });

        const result = {
          name: nameBase,
          ...comparison,
          actualPath,
          baselinePath,
          diffPath,
        };

        return {
          content: [{
            type: 'text',
            text:
              `Visual comparison completed.\n` +
              `Actual: ${actualPath}\n` +
              `Baseline: ${baselinePath}\n` +
              `Diff: ${diffPath}\n` +
              JSON.stringify(result, null, 2),
          }],
          isError: !result.passed,
        };
      }

      case 'pw_audit_links_buttons': {
        const audit = await auditLinksAndButtons(activePage, args);
        const filePath = jsonPath(args.name || 'links-buttons-audit');

        fs.writeFileSync(filePath, JSON.stringify(audit, null, 2), 'utf-8');

        return {
          content: [{
            type: 'text',
            text:
              `Link/button audit completed.\n` +
              `Audit JSON: ${filePath}\n` +
              `Visible links: ${audit.summary.visibleLinks}\n` +
              `Visible buttons: ${audit.summary.visibleButtons}\n` +
              `Checked links: ${audit.summary.checkedLinks}\n` +
              `Link issues: ${audit.summary.linkIssues}\n` +
              `Disabled visible buttons: ${audit.summary.disabledVisibleButtons}\n` +
              JSON.stringify(audit.summary, null, 2),
          }],
          isError: !audit.summary.passed,
        };
      }

      case 'pw_explore_helpcenter': {
        const exploration = await runAdvancedHelpCenterExploration(activePage, {
          name: args.name || 'web_help_centre_exploration',
          startUrl: activePage.url(),
          screenshotsDir,
          auditDir,
          readEnv,
        });

        const filePath = jsonPath(args.name || 'web_help_centre_exploration');
        fs.writeFileSync(filePath, JSON.stringify(exploration, null, 2), 'utf-8');

        return {
          content: [{
            type: 'text',
            text:
              `Advanced Help Centre exploration completed.
` +
              `Exploration JSON: ${filePath}
` +
              `Gen FAQ questions asked: ${exploration.summary.genFaqQuestionsAsked}
` +
              `Suggestion chips clicked: ${exploration.summary.suggestionChipsClicked}
` +
              `Source links opened: ${exploration.summary.sourceLinksOpened}
` +
              `Browse topics opened: ${exploration.summary.browseTopicsOpened}
` +
              `Articles opened: ${exploration.summary.articlesOpened}
` +
              `Feedback submitted: ${exploration.summary.feedbackSubmitted}
` +
              `Olive launched: ${exploration.summary.oliveLaunched}
` +
              `App landing opened: ${exploration.summary.appLandingOpened}
` +
              `Screenshots:
${exploration.screenshots.join('\n')}
` +
              `Warnings: ${exploration.warnings.length}
` +
              `Errors: ${exploration.errors.length}
` +
              JSON.stringify(exploration.summary, null, 2),
          }],
          isError: !exploration.summary.passed,
        };
      }

      case 'pw_open_olive': {
        const surface = await olive.open();

        /*
         * Use the readiness implementation already maintained by the
         * chatbot driver. Once this succeeds, sendMessage() reuses the
         * same ready state instead of waiting for the greeting again.
         */
        const readiness =
          await olive.waitUntilReady(surface);

        return {
          content: [{
            type: 'text',
            text: JSON.stringify({
              opened: true,
              ready: true,
              surface: 'chatbot_widget',
              inputAvailable: true,
              chatContainerFound: true,
              greetingDetected:
                Boolean(
                  readiness?.greetingLines?.length
                ),
              readinessFallback:
                Boolean(readiness?.fallback),
            }),
          }],
        };
      }

      case 'pw_send_olive_message': {
        const result =
          await olive.sendMessage(args.text);

        /*
         * Return only the latest chatbot turn to the orchestrator.
         * Screenshots and detailed evidence remain local and must not
         * inflate the next Gemini prompt.
         */
        const compactResult = {
          userMessage:
            String(result.userMessage || args.text)
              .slice(0, 1000),

          botResponse:
            String(result.botResponse || '')
              .slice(
                0,
                Number(
                  readEnv(
                    'MAX_CHATBOT_RESPONSE_CHARS',
                    '2500'
                  )
                )
              ),

          conversationState:
            result.conversationState ||
            'UNKNOWN',

          newBotMessageCount:
            Number(
              result.newBotMessageCount || 0
            ),

          screenshotCaptured:
            Boolean(result.screenshotPath),
        };

        return {
          content: [{
            type: 'text',
            text: JSON.stringify(compactResult),
          }],
        };
      }

      case 'pw_read_olive_conversation': {
        const text = await olive.readConversationText();

        return {
          content: [{ type: 'text', text }],
        };
      }

      case 'pw_click_button': {
        const locator = activePage.getByRole('button', { name: new RegExp(args.targetText, 'i') }).first();

        if (await locator.isVisible({ timeout: 5000 }).catch(() => false)) {
          await locator.click();
        } else {
          await activePage.locator(`text=${args.targetText}`).first().click({ timeout: 10000 });
        }

        await waitForStablePage(activePage);

        return {
          content: [{ type: 'text', text: `Clicked element matching ${args.targetText}` }],
        };
      }

      case 'pw_type_and_enter': {
        const input = activePage.locator('textarea, input[type="text"], [contenteditable="true"]').last();

        await input.waitFor({ timeout: 10000 });
        await input.fill(args.text);
        await input.press('Enter');
        await waitForStablePage(activePage);

        return {
          content: [{ type: 'text', text: 'Typed text and pressed Enter.' }],
        };
      }

      case 'pw_verify_text_present': {
        const isVisible = await activePage.locator(`text=${args.expectedText}`).first().isVisible({ timeout: 10000 }).catch(() => false);

        return isVisible
          ? { content: [{ type: 'text', text: `PASSED: ${args.expectedText} is visible.` }] }
          : {
              content: [{ type: 'text', text: `FAILED: ${args.expectedText} is not visible.` }],
              isError: true,
            };
      }

      default:
        throw new Error(`Tool implementation for ${name} not found.`);
    }
  } catch (error) {
    let screenshotNote = '';

    try {
      if (page) {
        const errorShot = screenshotPath(`automation-error-${Date.now()}`, screenshotsDir);
        await page.screenshot({ path: errorShot, fullPage: true });
        screenshotNote = `\nScreenshot: ${errorShot}`;
      }
    } catch (_) {}

    return {
      content: [{ type: 'text', text: `Automation Error: ${error.message}${screenshotNote}` }],
      isError: true,
    };
  }
});

async function run() {
  await server.connect(new StdioServerTransport());
}

process.on('exit', () => {
  if (browser) browser.close().catch(() => {});
});

run().catch(error => {
  console.error(error);
  process.exit(1);
});
